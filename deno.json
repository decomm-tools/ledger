{
  "name": "@decomm/ledger",
  "version": "1.0.1",
  "license": "MIT",
  "exports": {
    ".": "./main.ts",
    "./init": "./init.ts"
  },
  "publish": {
    "include": [
      "main.ts",
      "args.ts",
      "hash.ts",
      "store.ts",
      "ui.ts",
      "init.ts",
      "ledger.sh",
      "README.md",
      "LICENSE",
      "deno.json",
      "jsr.json"
    ]
  },
  "tasks": {
    "ledger": "deno run --allow-read --allow-write --allow-net --allow-env=LEDGER_DIR main.ts",
    "dev": "deno run --allow-read --allow-write --allow-net --allow-env=LEDGER_DIR --watch main.ts serve",
    "compile": "mkdir -p bin && deno compile --allow-read --allow-write --allow-net --allow-env=LEDGER_DIR --output bin/ledger main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env",
    "check": "deno check main.ts args.ts hash.ts store.ts ui.ts init.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  }
}
